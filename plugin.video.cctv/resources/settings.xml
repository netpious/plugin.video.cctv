<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- 这是 Kodi 的「旧版」设置定义（<settings> 不带 version），类型名必须是
     旧版那一套：text / number / bool / folder / select / enum / slider …

     踩过的坑（2026-10-31 的 kodi.log 实锤）：
       * 写 type="integer"  → failed to parse old setting definition … of type "integer"
       * 写 type="string"   → failed to parse old setting definition … of type "string"
       * 只有 type="bool" 能过
     结果是整份设置都读不出来：getSettingString 抛 TypeError('Invalid setting type')，
     日志里一行 "EXCEPTION: Invalid setting type"，设置界面空白，下载目录也改不了。
     旧版里整数叫 number、文本叫 text、目录叫 folder —— 别用新版那套
     boolean / integer / string（那是 <settings version="1"> 才搭配的写法）。 -->
<settings>
  <category label="常规">
    <setting id="show_thumb" type="bool" label="显示缩略图" default="true"/>
  </category>
  <category label="频道显示">
    <setting id="ch_panda" type="bool" label="熊猫" default="true"/>
    <setting id="ch_chunwan" type="bool" label="总台春晚" default="true"/>
    <setting id="ch_difang" type="bool" label="地方" default="true"/>
    <setting id="ch_xiangcun" type="bool" label="乡村振兴" default="true"/>
    <setting id="ch_shengtai" type="bool" label="生态" default="true"/>
    <setting id="ch_yidaiyilu" type="bool" label="一带一路" default="true"/>
    <setting id="ch_yangbo" type="bool" label="央博" default="true"/>
    <setting id="ch_wenhua" type="bool" label="文化" default="true"/>
    <setting id="ch_lvyou" type="bool" label="旅游" default="true"/>
    <setting id="ch_kepu" type="bool" label="科普" default="true"/>
    <setting id="ch_jiankang" type="bool" label="健康" default="true"/>
    <setting id="ch_leling" type="bool" label="乐龄" default="true"/>
    <setting id="ch_yuedu" type="bool" label="阅读" default="true"/>
    <setting id="ch_yishu" type="bool" label="艺术" default="true"/>
    <setting id="ch_shuzhi" type="bool" label="数智" default="true"/>
    <setting id="ch_5g" type="bool" label="5G" default="true"/>
    <setting id="ch_chanye" type="bool" label="产业+" default="true"/>
  </category>
  <category label="播放">
    <setting id="h5e_play" type="bool"
             label="高画质播放（本地解密 720P/1080P）" default="true"/>
  </category>
  <category label="下载">
    <setting id="download_path" type="folder" label="下载目录（留空用默认）"
             default="special://profile/addon_data/plugin.video.cctv/downloads/"
             option="writeable"/>
  </category>
</settings>